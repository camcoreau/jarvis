# Jarvis | CamCore AI — Portainer stack environment
# Copy these values into the Portainer stack environment. Do not commit .env.

# Immutable GHCR tag published by the CamCore image workflow after merge.
CAMCORE_JARVIS_RELEASE=

# Conservative CPU-first local model. This remains available for privacy and fallback.
CAMCORE_JARVIS_MODEL=qwen3.5:4b

# Docker network already shared with Nginx Proxy Manager.
CAMCORE_PROXY_NETWORK=

# Required because Jarvis listens on a non-loopback container interface.
# Generate securely and store only in Portainer/NPM secret-bearing config.
OPENJARVIS_API_KEY=

# CamCore production access boundary. The authenticated reverse proxy must add
# the matching shared secret plus X-CamCore-Subject and X-CamCore-Role headers.
# Role must be either member or admin and must be derived from the upstream SSO
# policy, not from browser-controlled input.
CAMCORE_ACCESS_MODE=trusted-proxy
CAMCORE_PROXY_IDENTITY_SECRET=

# Read-only Outline MCP credential. Store the real value only in Portainer.
CAMCORE_OUTLINE_API_KEY=

# Live Docker control plane. Portainer is Docker-only evidence, never NAS/SMART/UPS.
CAMCORE_PORTAINER_URL=
CAMCORE_PORTAINER_API_KEY=
CAMCORE_PORTAINER_VERIFY_TLS=true

# Better Stack Uptime — monitor state and unresolved incidents only.
CAMCORE_BETTERSTACK_API_TOKEN=
CAMCORE_BETTERSTACK_TEAM=

# YouTrack — bounded read-only work query. A read-only/service token is preferred.
CAMCORE_YOUTRACK_URL=https://tasks.camcore.network
CAMCORE_YOUTRACK_TOKEN=
CAMCORE_YOUTRACK_QUERY=#Unresolved

# Home Assistant — read only, and only for entity IDs listed here. Do not add
# location trackers or other sensitive entities unless there is a clear need.
CAMCORE_HOMEASSISTANT_URL=https://home.camcore.network
CAMCORE_HOMEASSISTANT_TOKEN=
CAMCORE_HOMEASSISTANT_ENTITIES=

# Microsoft Graph service health — app registration should have only
# ServiceHealth.Read.All application permission for this integration.
CAMCORE_M365_TENANT_ID=
CAMCORE_M365_CLIENT_ID=
CAMCORE_M365_CLIENT_SECRET=

# GitHub — repositories are allow-listed server-side. Public repositories can be
# read without a token, but a read-only fine-grained token avoids low anonymous
# rate limits and is required for private repositories.
CAMCORE_GITHUB_REPOSITORIES=camcoreau/jarvis
CAMCORE_GITHUB_TOKEN=

# Synology DSM capability discovery only. This tool calls SYNO.API.Info and does
# not claim physical disk, SMART, storage-pool, RAID/SHR, free-space or UPS health.
CAMCORE_SYNOLOGY_URL=

# Optional OpenAI hybrid provider. Leave blank to run Local-only. Cloud inference
# remains an explicit selection when configured; Auto is local-first.
OPENAI_API_KEY=
CAMCORE_OPENAI_MODEL=gpt-5.6
CAMCORE_OPENAI_FALLBACK_LOCAL=true

# Role policy. Both member and administrator Auto modes stay local-first.
CAMCORE_MEMBER_OPENAI_ENABLED=true
CAMCORE_ADMIN_OPENAI_ENABLED=true
CAMCORE_MEMBER_AUTO_PROVIDER=local
CAMCORE_ADMIN_AUTO_PROVIDER=local

CAMCORE_TZ=Australia/Melbourne
